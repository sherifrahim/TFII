# ── TFII Environment Configuration ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── Domain ───────────────────────────────────────────────────────────────────
# Your server domain (without https://)
# Used to build the React app and set CORS origins
DOMAIN=your-domain.com

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=postgres          # Use 'postgres' for Docker, 'localhost' for manual
DB_NAME=threatfeeddb
DB_USER=threatfeed
DB_PASS=change_this_strong_password

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_64_char_hex_string

# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=https://your-domain.com

# JWT expiry in minutes (default: 120)
TOKEN_EXPIRE_MINUTES=120

# Encryption key for stored API keys
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace_with_fernet_key

# ── API Keys (all optional — platform degrades gracefully without them) ──────

# VirusTotal — https://www.virustotal.com/gui/my-apikey
VT_API_KEY=

# AbuseIPDB — https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# URLhaus (abuse.ch) — free, but mandatory since 30 Jun 2025. Get one at https://auth.abuse.ch/
URLHAUS_AUTH_KEY=

# NVD (higher rate limits) — https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Groq (KQL/SPL query builder) — https://console.groq.com/keys
GROQ_API_KEY=

# Shodan (OSINT) — https://account.shodan.io/
SHODAN_API_KEY=

# HaveIBeenPwned — https://haveibeenpwned.com/API/Key
HIBP_API_KEY=
